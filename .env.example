# Server
PORT=8787
DB_PATH=./scandem.db
PAYMENTS_REQUIRED=true
ADMIN_TOKEN=change-me
PRICE_USD=5
XCD_PER_USD=2.7
MOCK_PAYMENTS=true
# Anonymized debug log emailed to support after each download. Set to false to disable.
DEBUG_LOG_ENABLED=true

# Client (build time) - AdSense (no ads are loaded if CLIENT is unset)
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_SLOT=0000000000   # shared by all placements unless overridden below
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADSENSE_SLOT_BOTTOM=
