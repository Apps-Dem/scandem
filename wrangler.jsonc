{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scandem",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "scandem.alldem.app", "custom_domain": true },
    { "pattern": "alldem.app", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "scandem", "database_id": "3e4b7115-df1e-46bb-9f2d-098256e65dd6", "migrations_dir": "server/migrations" }
  ],
  "vars": {
    "PAYMENTS_REQUIRED": "false",
    "PRICE_USD": "5",
    "XCD_PER_USD": "2.7",
    "MOCK_PAYMENTS": "false"
  },
  "observability": { "enabled": true }
}
